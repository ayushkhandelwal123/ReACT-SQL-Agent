# Copy this file to .env and fill in your real values.
# .env should NEVER be committed — it's already in .gitignore.

# --- LangSmith tracing ---
# Get your key from https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...your_key_here...
LANGSMITH_PROJECT=sql-agent-chinook
